---
import IconPill from '@components/IconPill';
import PlainPill from '@components/PlainPill';
import CardLayout from '@layouts/CardLayout.astro';
---

<CardLayout id="intro-header" classStyle="bg-gradient-to-br from-secondary-dark/90 via-primary-dark/100 to-myTextBlue/70 text-white min-h-[60vh] flex items-center overflow-hidden relative">
  <!-- Background Particle Animation -->
  <div class="absolute inset-0 opacity-30 pointer-events-none">
    <div class="animate-particle-float bg-primary-dark/50 w-2 h-2 rounded-full absolute top-10 left-20"></div>
    <div class="animate-particle-float-delayed bg-myTextBlue/50 w-3 h-3 rounded-full absolute top-40 right-10"></div>
    <div class="animate-particle-float bg-primary-light/50 w-2 h-2 rounded-full absolute bottom-20 left-40"></div>
    <div class="animate-particle-float-delayed bg-myTextBlue/50 w-3 h-3 rounded-full absolute bottom-10 right-30"></div>
  </div>

  <div class="container mx-auto px-4 z-10">
    <div class="flex flex-col md:flex-row items-center gap-6 md:gap-12">
      <!-- Left: Animated Avatar -->
      <div class="w-full md:w-1/3 flex justify-center">
        <div class="relative group cursor-pointer" data-cursor="rocket">
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-full border-4 border-primary-dark/30 shadow-xl flex items-center justify-center bg-gradient-to-br from-primary-dark/40 to-myTextBlue/40 transform transition-all duration-500 ease-out-expo group-hover:scale-110 group-hover:rotate-3 group-hover:shadow-[0_0_20px_5px] group-hover:shadow-primary-dark/50 animate-float">
            <span class="text-6xl md:text-8xl animate-cycle-emoji"></span>
          </div>
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-primary-dark/20 to-myTextBlue/20 group-hover:opacity-80 transition-opacity duration-500 ease-in-out-cubic"></div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="w-full md:w-2/3 text-center md:text-left font-doses">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-primary-light animate-fade-in" style="animation-delay: 0.2s;">
          Hi, I'm Maria 
          <span class="inline-block animate-wave">👋</span>
        </h1>
        <div class="flex flex-wrap gap-2 mb-4 justify-center md:justify-start animate-fade-in" style="animation-delay: 0.4s;">
          <PlainPill
            id="fullstack"
            description="Fullstack"
          />
          <PlainPill
            id="cloud"
            description="Cloud"
          />
          <PlainPill
            id="devops"
            description="DevOps"
          />
        
          
        </div>
    <p class="text-base md:text-lg max-w-2xl mb-6 text-secondary-dark dark:text-primary cursor-pointer animate-fade-in" data-cursor="text" style="animation-delay: 0.6s;">
             I’m passionate about turning ideas into impactful products, be it building fun web applications, integrating hardware and software, or experimenting with creative side projects. I value clear communication with end users and stakeholders, ensuring that what I build not only works well but truly meets people’s needs. Outside of work, I enjoy exploring new technologies, working on personal projects, and creating something handmade like jewelry and crochet pieces. I love keeping curiosity and creativity at the heart of my every day life.
           </p>
        <div class="flex flex-wrap gap-4 justify-center md:justify-start animate-fade-in" style="animation-delay: 0.8s;">
          <a href="mailto:mariafailli42@gmail.com" target="_self" class="cursor-pointer group" data-cursor="email">
            <IconPill
              iconSrc="/images/email.svg"
              description="Email Me"
              classListItems="group-hover:translate-y-[-2px] group-hover:shadow-lg group-hover:shadow-primary-dark/20 transition-all duration-300 ease-out-expo"
            />
          </a>
          <a href="/projects" class="cursor-pointer group" data-cursor="portfolio">
            <IconPill
              iconSrc="/images/portfolio.svg"
              classListItems="group-hover:translate-y-[-2px] group-hover:shadow-lg group-hover:shadow-primary-dark/20 transition-all duration-300 ease-out-expo"
            />
          </a>
          <a href="https://github.com/Maria4lexzy" class="cursor-pointer group" data-cursor="github">
            <IconPill
              iconSrc="/images/github.svg"
              classListItems="group-hover:translate-y-[-2px] group-hover:shadow-lg group-hover:shadow-primary-dark/20 transition-all duration-300 ease-out-expo"
            />
          </a>
          <a href="https://www.linkedin.com/in/maria-louisa-failli/" class="cursor-pointer group" data-cursor="linkedin">
            <IconPill
              iconSrc="/images/linkedin.svg"
              classListItems="group-hover:translate-y-[-2px] group-hover:shadow-lg group-hover:shadow-primary-dark/20 transition-all duration-300 ease-out-expo"
            />
          </a>
          <a href="https://stackoverflow.com/users/12344726/maria" class="cursor-pointer group" data-cursor="stackoverflow">
            <IconPill
              iconSrc="/images/stackoverflow.svg"
              classListItems="group-hover:translate-y-[-2px] group-hover:shadow-lg group-hover:shadow-primary-dark/20 transition-all duration-300 ease-out-expo"
            />
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes wave {
      0% { transform: rotate(0deg); }
      10% { transform: rotate(14deg); }
      20% { transform: rotate(-8deg); }
      30% { transform: rotate(14deg); }
      40% { transform: rotate(-4deg); }
      50% { transform: rotate(10deg); }
      60% { transform: rotate(0deg); }
      100% { transform: rotate(0deg); }
    }
    .animate-wave {
      animation: wave 2.5s infinite;
      transform-origin: 70% 70%;
      display: inline-block;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(2deg); }
    }
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }

    @keyframes particle-float {
      0%, 100% { transform: translateY(0) translateX(0); opacity: 0.5; }
      50% { transform: translateY(-20px) translateX(10px); opacity: 0.8; }
    }
    .animate-particle-float {
      animation: particle-float 8s ease-in-out infinite;
    }
    .animate-particle-float-delayed {
      animation: particle-float 8s ease-in-out infinite 2s;
    }

    @keyframes fade-in {
      0% { opacity: 0; transform: translateY(10px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fade-in 0.8s ease-out-expo forwards;
    }

    @keyframes cycle-emoji {
      0%, 20% { content: "💻"; opacity: 1; }
      22% { opacity: 0; }
      24% { content: "🧶"; opacity: 0; }
      26%, 40% { content: "🧶"; opacity: 1; }
      42% { opacity: 0; }
      44% { content: "🤖"; opacity: 0; }
      46%, 60% { content: "🤖"; opacity: 1; }
      62% { opacity: 0; }
      64% { content: "🏔️"; opacity: 0; }
      66%, 80% { content: "🏔️"; opacity: 1; }
      82% { opacity: 0; }
      84% { content: "🌍"; opacity: 0; }
      86%, 100% { content: "🌍"; opacity: 1; }
    }
    .animate-cycle-emoji::before {
      content: "💻";
      display: inline-block;
      animation: cycle-emoji 15s ease-in-out infinite;
    }


  </style>

  <script>
   
